WP_BASE_URL=https://your-site.example
WP_USERNAME=mcp-editor
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# stdio | http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3847
MCP_HTTP_AUTH_TOKEN=

# Comma-separated tool names; empty = all
MCP_TOOL_ALLOWLIST=

MCP_RATE_LIMIT_PER_MINUTE=60
MCP_ENABLE_WRITES=true

# OAuth scaffolding (optional; WordPress.com / custom IdP)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTHORIZE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_REDIRECT_URI=http://127.0.0.1:3847/oauth/callback
